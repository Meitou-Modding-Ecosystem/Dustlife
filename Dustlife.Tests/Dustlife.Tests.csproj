<Project Sdk="Microsoft.NET.Sdk">

  <!-- The mod's tests: synthetic worlds only, no game install needed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Dustlife.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Game/Meitou.Game.csproj" />
    <ProjectReference Include="../Dustlife/Dustlife.csproj" />
  </ItemGroup>

  <!--
    The locked Rivalry Core (meitou.lock.json) under the alias "rivalry": RivalryLinkTests keeps a stand-in with the same full type names, the
    way RivalryLink finds the real one by reflection, and RivalryContractTests checks those names against the real assembly.
  -->
  <Target Name="AliasRivalryCore" AfterTargets="MeitouReferenceFrameworks">
    <ItemGroup>
      <Reference Condition="'%(Reference.Filename)' == 'RivalryCore'">
        <Aliases>rivalry</Aliases>
      </Reference>
    </ItemGroup>
  </Target>

</Project>
